# Qdrant (Qdrant Cloud recommended for Cloud Run)
QDRANT_API_KEY=your_qdrant_api_key_here
CLUSTER_ENDPOINT=https://your-cluster.qdrant.io:6333

# OpenRouter — embeddings + LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_LLM_MODEL=google/gemini-2.5-flash

# Optional legacy (not required if OpenRouter LLM is set)
# GOOGLE_API_KEY=your_google_api_key_here
